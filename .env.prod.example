DEBUG=False
SECRET_KEY=generate_a_strong_secret_key_on_server
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# PostgreSQL Configuration
POSTGRES_DB=tutor_booking_prod
POSTGRES_USER=tutor_user
POSTGRES_PASSWORD=set_a_very_secure_password_here

# Django Database URL (Postgres service hostname matches the Docker service name)
DATABASE_URL=postgres://tutor_user:set_a_very_secure_password_here@postgres:5432/tutor_booking_prod

# Celery & Redis Configuration
CELERY_BROKER_URL=redis://redis:6379/0

# Site Identity & URLs
SITE_NAME="English with Mary"
SITE_URL=https://yourdomain.com
DEFAULT_FROM_EMAIL="English with Mary <noreply@englishwithmary.ir>"

# Email Configuration (Primary: Brevo HTTP API via Anymail)
# Sends transactional emails via Brevo REST API over HTTPS (port 443),
# bypassing SMTP routing, IPv6 fallback, and port blockage issues.
# Generate API key at Brevo Dashboard -> SMTP & API -> API Keys.
BREVO_API_KEY=your_brevo_v3_api_key_here

# Fallback: SMTP Configuration (e.g. Gmail SMTP or Brevo SMTP Relay)
# Used only if BREVO_API_KEY is not set or EMAIL_BACKEND is explicitly set to SMTP.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your_dedicated_email@gmail.com
# EMAIL_HOST_PASSWORD=your_16_char_app_password