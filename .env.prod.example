DEBUG=False
SECRET_KEY=generate_a_strong_secret_key_on_server
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# PostgreSQL Configuration
POSTGRES_DB=tutor_booking_prod
POSTGRES_USER=tutor_user
POSTGRES_PASSWORD=set_a_very_secure_password_here

# Django Database URL (Postgres service hostname matches the Docker service name)
DATABASE_URL=postgres://tutor_user:set_a_very_secure_password_here@postgres:5432/tutor_booking_prod

# Celery & Redis Configuration
CELERY_BROKER_URL=redis://redis:6379/0

# Site Identity & URLs
SITE_NAME="English with Mary"
SITE_URL=https://yourdomain.com
DEFAULT_FROM_EMAIL="English with Mary <noreply@yourdomain.com>"